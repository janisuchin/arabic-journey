  {"id": "muhandis", "ar": "مُهَنْدِس", "en": "engineer (m)", "pos": "noun", "gender": "m", "plural": "مُهَنْدِسُون", "forms": [{"label": "feminine", "ar": "مُهَنْدِسَة"}], "emoji": "👷", "topic": "jobs", "level": 1, "example": {"ar": "أَبُو سَامِي مُهَنْدِس.", "en": "Sami's father is an engineer."}},
  {"id": "muwazzaf", "ar": "مُوَظَّف", "en": "employee, office worker (m)", "pos": "noun", "gender": "m", "plural": "مُوَظَّفُون", "forms": [{"label": "feminine", "ar": "مُوَظَّفَة"}], "emoji": "🧑‍💼", "topic": "jobs", "level": 1, "example": {"ar": "أَبِي مُوَظَّف فِي شَرِكَة.", "en": "My father is an employee at a company."}},
  {"id": "mumarrid", "ar": "مُمَرِّض", "en": "nurse (m)", "pos": "noun", "gender": "m", "plural": "مُمَرِّضُون", "forms": [{"label": "feminine", "ar": "مُمَرِّضَة"}], "emoji": "🧑‍⚕️", "topic": "jobs", "level": 1, "example": {"ar": "هِيَ مُمَرِّضَة فِي الْمُسْتَشْفَى.", "en": "She is a nurse at the hospital."}},
  {"id": "mutarjim", "ar": "مُتَرْجِم", "en": "translator (m)", "pos": "noun", "gender": "m", "plural": "مُتَرْجِمُون", "forms": [{"label": "feminine", "ar": "مُتَرْجِمَة"}], "emoji": "🗣️", "topic": "jobs", "level": 1, "example": {"ar": "الْأُسْتَاذ كَرِيم مُتَرْجِم أَيْضًا.", "en": "Mr Karim is a translator too."}},
  {"id": "sharika", "ar": "شَرِكَة", "en": "company", "pos": "noun", "gender": "f", "plural": "شَرِكَات", "emoji": "🏢", "topic": "jobs", "level": 1, "example": {"ar": "هٰذِهِ شَرِكَة كَبِيرَة.", "en": "This is a big company."}},
  {"id": "mustashfa", "ar": "مُسْتَشْفَى", "en": "hospital", "pos": "noun", "gender": "m", "plural": "مُسْتَشْفَيَات", "emoji": "🏥", "topic": "jobs", "level": 1, "example": {"ar": "الْمُسْتَشْفَى قَرِيب.", "en": "The hospital is near."}, "note": "It ends in ى, but it is masculine: مُسْتَشْفَى كَبِير (a big hospital)."},
  {"id": "yawm", "ar": "يَوْم", "en": "day", "pos": "noun", "gender": "m", "plural": "أَيَّام", "emoji": "📅", "topic": "time", "level": 1, "example": {"ar": "الْيَوْم يَوْمُ الثُّلَاثَاء.", "en": "Today is Tuesday."}, "note": "الْيَوْم (the day) also means 'today'."},
  {"id": "usbu", "ar": "أُسْبُوع", "en": "week", "pos": "noun", "gender": "m", "plural": "أَسَابِيع", "emoji": "🗓️", "topic": "time", "level": 1, "example": {"ar": "فِي الْأُسْبُوع سَبْعَة أَيَّام.", "en": "There are seven days in a week."}},
  {"id": "al-ahad", "ar": "الْأَحَد", "en": "Sunday", "pos": "noun", "gender": "m", "emoji": "📆", "topic": "days", "level": 1, "example": {"ar": "الدَّرْس يَوْمَ الْأَحَد.", "en": "The lesson is on Sunday."}, "note": "Literally 'the first': the Arab week starts on Sunday."},
  {"id": "al-ithnayn", "ar": "الاِثْنَيْن", "en": "Monday", "pos": "noun", "gender": "m", "emoji": "📆", "topic": "days", "level": 1, "example": {"ar": "عِنْدِي دَرْس يَوْمَ الاِثْنَيْن.", "en": "I have a lesson on Monday."}, "note": "From اِثْنَان (two): the second day of the week."},
  {"id": "ath-thulatha", "ar": "الثُّلَاثَاء", "en": "Tuesday", "pos": "noun", "gender": "m", "emoji": "📆", "topic": "days", "level": 1, "example": {"ar": "الْيَوْم يَوْمُ الثُّلَاثَاء.", "en": "Today is Tuesday."}, "note": "From ثَلَاثَة (three): the third day."},
  {"id": "al-arbia", "ar": "الْأَرْبِعَاء", "en": "Wednesday", "pos": "noun", "gender": "m", "emoji": "📆", "topic": "days", "level": 1, "example": {"ar": "نَدْرُسُ مَعًا يَوْمَ الْأَرْبِعَاء.", "en": "We study together on Wednesday."}, "note": "From أَرْبَعَة (four): the fourth day."},
  {"id": "al-khamis", "ar": "الْخَمِيس", "en": "Thursday", "pos": "noun", "gender": "m", "emoji": "📆", "topic": "days", "level": 1, "example": {"ar": "أَذْهَبُ إِلَى بَيْتِ سَامِي يَوْمَ الْخَمِيس.", "en": "I go to Sami's house on Thursday."}, "note": "From خَمْسَة (five): the fifth day."},
  {"id": "al-jumua", "ar": "الْجُمُعَة", "en": "Friday", "pos": "noun", "gender": "f", "emoji": "🕌", "topic": "days", "level": 1, "example": {"ar": "الْجُمُعَة عُطْلَة.", "en": "Friday is a day off."}, "note": "The day of the gathering, when Muslims meet for the Friday prayer. In Egypt the weekend is Friday and Saturday."},
  {"id": "as-sabt", "ar": "السَّبْت", "en": "Saturday", "pos": "noun", "gender": "m", "emoji": "📆", "topic": "days", "level": 1, "example": {"ar": "يَوْمَ السَّبْت أَنَا فِي الْبَيْت.", "en": "On Saturday I am at home."}, "note": "The same old word as English 'Sabbath'."},
  {"id": "ghadan", "ar": "غَدًا", "en": "tomorrow", "pos": "adverb", "emoji": "➡️", "topic": "time", "level": 1, "example": {"ar": "غَدًا يَوْمُ الْجُمُعَة.", "en": "Tomorrow is Friday."}},
  {"id": "utla", "ar": "عُطْلَة", "en": "holiday, day off", "pos": "noun", "gender": "f", "plural": "عُطَل", "emoji": "🏖️", "topic": "time", "level": 1, "example": {"ar": "السَّبْت عُطْلَة أَيْضًا.", "en": "Saturday is a day off too."}},
  {"id": "saa", "ar": "سَاعَة", "en": "hour; clock, watch; o'clock", "pos": "noun", "gender": "f", "plural": "سَاعَات", "emoji": "🕒", "topic": "time", "level": 1, "example": {"ar": "كَمِ السَّاعَة؟", "en": "What time is it?"}, "note": "السَّاعَة + a feminine ordinal tells the time: السَّاعَة الثَّالِثَة (three o'clock)."},
  {"id": "waqt", "ar": "وَقْت", "en": "time", "pos": "noun", "gender": "m", "plural": "أَوْقَات", "emoji": "⏳", "topic": "time", "level": 1, "example": {"ar": "هَلْ عِنْدَكَ وَقْت؟", "en": "Do you have time? (to a man)"}},
  {"id": "nisf", "ar": "نِصْف", "en": "half", "pos": "noun", "gender": "m", "emoji": "🌗", "topic": "time", "level": 1, "example": {"ar": "السَّاعَة الْعَاشِرَة وَالنِّصْف.", "en": "It is half past ten."}},
  {"id": "rub", "ar": "رُبْع", "en": "quarter", "pos": "noun", "gender": "m", "emoji": "🕒", "topic": "time", "level": 1, "example": {"ar": "السَّاعَة الثَّالِثَة وَالرُّبْع.", "en": "It is quarter past three."}},
  {"id": "illa", "ar": "إِلَّا", "en": "except; (in times) to", "pos": "particle", "emoji": "➖", "topic": "time", "level": 1, "example": {"ar": "السَّاعَة الثَّانِيَة إِلَّا رُبْعًا.", "en": "It is quarter to two."}, "note": "Literally 'except'. With رُبْع it takes the ending -an: إِلَّا رُبْعًا (minus a quarter)."},
  {"id": "daqiqa", "ar": "دَقِيقَة", "en": "minute", "pos": "noun", "gender": "f", "plural": "دَقَائِق", "emoji": "⏱️", "topic": "time", "level": 1, "example": {"ar": "دَقِيقَة وَاحِدَة، مِنْ فَضْلِكَ!", "en": "One minute, please!"}},
  {"id": "sabahan", "ar": "صَبَاحًا", "en": "in the morning, a.m.", "pos": "adverb", "emoji": "🌄", "topic": "time", "level": 1, "example": {"ar": "السَّاعَة الثَّامِنَة صَبَاحًا.", "en": "Eight o'clock in the morning."}},
  {"id": "masaan", "ar": "مَسَاءً", "en": "in the evening, p.m.", "pos": "adverb", "emoji": "🌇", "topic": "time", "level": 1, "example": {"ar": "السَّاعَة السَّابِعَة مَسَاءً.", "en": "Seven o'clock in the evening."}},
  {"id": "mutaakhkhir", "ar": "مُتَأَخِّر", "en": "late", "pos": "adj", "forms": [{"label": "feminine", "ar": "مُتَأَخِّرَة"}], "emoji": "⏰", "topic": "time", "level": 1, "example": {"ar": "أَنَا مُتَأَخِّر، آسِف!", "en": "I am late, sorry!"}, "note": "A woman says أَنَا مُتَأَخِّرَة."},
  {"id": "al-an", "ar": "الْآن", "en": "now", "pos": "adverb", "emoji": "⌚", "topic": "time", "level": 1, "example": {"ar": "كَمِ السَّاعَة الْآن؟", "en": "What time is it now?"}},
  {"id": "yastayqizu", "ar": "يَسْتَيْقِظُ", "en": "to wake up", "pos": "verb", "forms": [{"label": "past", "ar": "اِسْتَيْقَظَ"}, {"label": "present", "ar": "يَسْتَيْقِظُ"}, {"label": "I", "ar": "أَسْتَيْقِظُ"}], "emoji": "⏰", "topic": "routine", "level": 1, "example": {"ar": "أَسْتَيْقِظُ فِي السَّاعَة السَّابِعَة.", "en": "I wake up at seven o'clock."}, "note": "Dictionaries list a verb by its past 'he' form, here اِسْتَيْقَظَ. This course shows the present 'he' form first."},
  {"id": "yaghsilu", "ar": "يَغْسِلُ", "en": "to wash", "pos": "verb", "forms": [{"label": "past", "ar": "غَسَلَ"}, {"label": "present", "ar": "يَغْسِلُ"}, {"label": "I", "ar": "أَغْسِلُ"}], "emoji": "🧼", "topic": "routine", "level": 1, "example": {"ar": "أَغْسِلُ وَجْهِي.", "en": "I wash my face."}},
  {"id": "yashrabu", "ar": "يَشْرَبُ", "en": "to drink", "pos": "verb", "forms": [{"label": "past", "ar": "شَرِبَ"}, {"label": "present", "ar": "يَشْرَبُ"}, {"label": "I", "ar": "أَشْرَبُ"}], "emoji": "🍵", "topic": "routine", "level": 1, "example": {"ar": "أَشْرَبُ الشَّاي صَبَاحًا.", "en": "I drink tea in the morning."}},
  {"id": "yadhhabu", "ar": "يَذْهَبُ", "en": "to go", "pos": "verb", "forms": [{"label": "past", "ar": "ذَهَبَ"}, {"label": "present", "ar": "يَذْهَبُ"}, {"label": "I", "ar": "أَذْهَبُ"}], "emoji": "🚶", "topic": "routine", "level": 1, "example": {"ar": "أَذْهَبُ إِلَى الْمَدْرَسَة.", "en": "I go to school."}, "note": "'To' a place is إِلَى: أَذْهَبُ إِلَى الْبَيْت (I go home)."},
  {"id": "yakhruju", "ar": "يَخْرُجُ", "en": "to go out, to leave", "pos": "verb", "forms": [{"label": "past", "ar": "خَرَجَ"}, {"label": "present", "ar": "يَخْرُجُ"}, {"label": "I", "ar": "أَخْرُجُ"}], "emoji": "🚪", "topic": "routine", "level": 1, "example": {"ar": "أَخْرُجُ مِنَ الْبَيْت مُبَكِّرًا.", "en": "I leave the house early."}, "note": "'From' a place is مِنْ, which becomes مِنَ before الـ: مِنَ الْبَيْت."},
  {"id": "sabah", "ar": "صَبَاح", "en": "morning", "pos": "noun", "gender": "m", "emoji": "🌅", "topic": "routine", "level": 1, "example": {"ar": "كُلَّ صَبَاح أَشْرَبُ الشَّاي.", "en": "Every morning I drink tea."}, "note": "You know it from صَبَاحُ الْخَيْر (good morning)."},
  {"id": "mubakkiran", "ar": "مُبَكِّرًا", "en": "early", "pos": "adverb", "emoji": "🐓", "topic": "routine", "level": 1, "example": {"ar": "أَسْتَيْقِظُ مُبَكِّرًا.", "en": "I wake up early."}},
  {"id": "thumma", "ar": "ثُمَّ", "en": "then, after that", "pos": "particle", "emoji": "➡️", "topic": "routine", "level": 1, "example": {"ar": "أَشْرَبُ الشَّاي، ثُمَّ أَذْهَبُ.", "en": "I drink tea, then I go."}},
  {"id": "kull", "ar": "كُلّ", "en": "every; all", "pos": "noun", "emoji": "🔁", "topic": "routine", "level": 1, "example": {"ar": "أَذْهَبُ إِلَى الْمَدْرَسَة كُلَّ يَوْم.", "en": "I go to school every day."}, "note": "كُلَّ يَوْم = every day, كُلَّ صَبَاح = every morning."},
  {"id": "yadrusu", "ar": "يَدْرُسُ", "en": "to study", "pos": "verb", "forms": [{"label": "past", "ar": "دَرَسَ"}, {"label": "present", "ar": "يَدْرُسُ"}, {"label": "I", "ar": "أَدْرُسُ"}], "emoji": "📚", "topic": "study", "level": 1, "example": {"ar": "أَدْرُسُ الْعَرَبِيَّة فِي الْقَاهِرَة.", "en": "I study Arabic in Cairo."}},
  {"id": "yamalu", "ar": "يَعْمَلُ", "en": "to work", "pos": "verb", "forms": [{"label": "past", "ar": "عَمِلَ"}, {"label": "present", "ar": "يَعْمَلُ"}, {"label": "I", "ar": "أَعْمَلُ"}], "emoji": "🛠️", "topic": "work", "level": 1, "example": {"ar": "يُوسُف يَعْمَلُ فِي شَرِكَة.", "en": "Yusuf works at a company."}, "note": "From the same root as عَمَل (work, job)."},
  {"id": "yaskunu", "ar": "يَسْكُنُ", "en": "to live (somewhere)", "pos": "verb", "forms": [{"label": "past", "ar": "سَكَنَ"}, {"label": "present", "ar": "يَسْكُنُ"}, {"label": "I", "ar": "أَسْكُنُ"}], "emoji": "🏠", "topic": "home", "level": 1, "example": {"ar": "أَسْكُنُ فِي الْقَاهِرَة.", "en": "I live in Cairo."}, "note": "Used for where you live: أَيْنَ تَسْكُنُ؟ (where do you live?, to a man)."},
  {"id": "nahnu", "ar": "نَحْنُ", "en": "we", "pos": "pronoun", "emoji": "👥", "topic": "pronouns", "level": 1, "example": {"ar": "نَحْنُ طُلَّاب.", "en": "We are students."}},
  {"id": "antum", "ar": "أَنْتُمْ", "en": "you (to a group)", "pos": "pronoun", "emoji": "🫵", "topic": "pronouns", "level": 1, "example": {"ar": "أَنْتُمْ طُلَّاب.", "en": "You are students."}, "note": "For a group of men or a mixed group."},
  {"id": "hum", "ar": "هُمْ", "en": "they (m or mixed)", "pos": "pronoun", "emoji": "👨‍👩‍👦", "topic": "pronouns", "level": 1, "example": {"ar": "هُمْ مِنْ مِصْر.", "en": "They are from Egypt."}},
  {"id": "jamia", "ar": "جَامِعَة", "en": "university", "pos": "noun", "gender": "f", "plural": "جَامِعَات", "emoji": "🏛️", "topic": "study", "level": 1, "example": {"ar": "يُوسُف يَدْرُسُ فِي الْجَامِعَة.", "en": "Yusuf studies at the university."}},
  {"id": "maktab", "ar": "مَكْتَب", "en": "office; desk", "pos": "noun", "gender": "m", "plural": "مَكَاتِب", "emoji": "🖥️", "topic": "work", "level": 1, "example": {"ar": "أَعْمَلُ فِي مَكْتَب.", "en": "I work in an office."}},
  {"id": "yarifu", "ar": "يَعْرِفُ", "en": "to know", "pos": "verb", "forms": [{"label": "past", "ar": "عَرَفَ"}, {"label": "present", "ar": "يَعْرِفُ"}, {"label": "I", "ar": "أَعْرِفُ"}], "emoji": "💡", "topic": "study", "level": 1, "example": {"ar": "لَا أَعْرِفُ.", "en": "I don't know."}},
  {"id": "yafhamu", "ar": "يَفْهَمُ", "en": "to understand", "pos": "verb", "forms": [{"label": "past", "ar": "فَهِمَ"}, {"label": "present", "ar": "يَفْهَمُ"}, {"label": "I", "ar": "أَفْهَمُ"}], "emoji": "🧠", "topic": "study", "level": 1, "example": {"ar": "أَفْهَمُ قَلِيلًا.", "en": "I understand a little."}},
  {"id": "yatakallamu", "ar": "يَتَكَلَّمُ", "en": "to speak", "pos": "verb", "forms": [{"label": "past", "ar": "تَكَلَّمَ"}, {"label": "present", "ar": "يَتَكَلَّمُ"}, {"label": "I", "ar": "أَتَكَلَّمُ"}], "emoji": "💬", "topic": "study", "level": 1, "example": {"ar": "أَتَكَلَّمُ الْعَرَبِيَّة قَلِيلًا.", "en": "I speak a little Arabic."}},
  {"id": "la", "ar": "لَا", "en": "no; not (before a present verb)", "pos": "particle", "emoji": "🚫", "topic": "study", "level": 1, "example": {"ar": "لَا أَفْهَمُ.", "en": "I don't understand."}, "note": "On its own لَا means 'no'. Before a present verb it means 'not'."},
  {"id": "sahl", "ar": "سَهْل", "en": "easy", "pos": "adj", "forms": [{"label": "feminine", "ar": "سَهْلَة"}], "emoji": "👍", "topic": "study", "level": 1, "example": {"ar": "الدَّرْس سَهْل.", "en": "The lesson is easy."}},
  {"id": "sab", "ar": "صَعْب", "en": "difficult, hard", "pos": "adj", "forms": [{"label": "feminine", "ar": "صَعْبَة"}], "emoji": "🧗", "topic": "study", "level": 1, "example": {"ar": "الْكَلِمَة صَعْبَة.", "en": "The word is difficult."}},
  {"id": "kalima", "ar": "كَلِمَة", "en": "word", "pos": "noun", "gender": "f", "plural": "كَلِمَات", "emoji": "🔤", "topic": "study", "level": 1, "example": {"ar": "مَا مَعْنَى هٰذِهِ الْكَلِمَة؟", "en": "What does this word mean?"}},
  {"id": "sual", "ar": "سُؤَال", "en": "question", "pos": "noun", "gender": "m", "plural": "أَسْئِلَة", "emoji": "❓", "topic": "study", "level": 1, "example": {"ar": "عِنْدِي سُؤَال.", "en": "I have a question."}},
  {"id": "al-arabiyya", "ar": "الْعَرَبِيَّة", "en": "Arabic (the language)", "pos": "noun", "gender": "f", "emoji": "🔡", "topic": "study", "level": 1, "example": {"ar": "أَدْرُسُ الْعَرَبِيَّة.", "en": "I study Arabic."}, "note": "Short for اللُّغَة الْعَرَبِيَّة (the Arabic language). English is الْإِنْجِلِيزِيَّة."},
