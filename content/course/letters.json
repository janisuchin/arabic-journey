  { "id": "ghayn", "char": "غ", "name": "ghayn", "nameAr": "غَيْن", "tr": "gh", "ipa": "ɣ", "sun": false, "day": 5, "sound": "like a gargled r, as in French 'Paris'", "example": { "ar": "غُرْفَة", "en": "room" } },
  { "id": "fa", "char": "ف", "name": "fāʾ", "nameAr": "فَاء", "tr": "f", "ipa": "f", "sun": false, "day": 6, "sound": "f as in 'fan'", "example": { "ar": "فِنْجَان", "en": "cup" } },
  { "id": "qaf", "char": "ق", "name": "qāf", "nameAr": "قَاف", "tr": "q", "ipa": "q", "sun": false, "day": 6, "sound": "a k made further back, at the uvula", "example": { "ar": "قَلَم", "en": "pen" } },
  { "id": "kaf", "char": "ك", "name": "kāf", "nameAr": "كَاف", "tr": "k", "ipa": "k", "sun": false, "day": 6, "sound": "k as in 'kite'", "example": { "ar": "كِتَاب", "en": "book" } },
  { "id": "lam", "char": "ل", "name": "lām", "nameAr": "لَام", "tr": "l", "ipa": "l", "sun": true, "day": 6, "sound": "a clear l as in 'leaf'", "example": { "ar": "لَيْل", "en": "night" } },
  { "id": "mim", "char": "م", "name": "mīm", "nameAr": "مِيم", "tr": "m", "ipa": "m", "sun": false, "day": 7, "sound": "m as in 'moon'", "example": { "ar": "مَاء", "en": "water" } },
  { "id": "nun", "char": "ن", "name": "nūn", "nameAr": "نُون", "tr": "n", "ipa": "n", "sun": true, "day": 7, "sound": "n as in 'noon'", "example": { "ar": "نُور", "en": "light" } },
  { "id": "haa", "char": "ه", "name": "hāʾ", "nameAr": "هَاء", "tr": "h", "ipa": "h", "sun": false, "day": 7, "sound": "h as in 'hat', also pronounced at the end of a word", "example": { "ar": "هُوَ", "en": "he" } },
  { "id": "waw", "char": "و", "name": "wāw", "nameAr": "وَاو", "tr": "w / ū", "ipa": "w, uː", "sun": false, "day": 7, "sound": "w as in 'wet', or a long 'oo' after a damma", "example": { "ar": "وَلَد", "en": "boy" } },
  { "id": "ya", "char": "ي", "name": "yāʾ", "nameAr": "يَاء", "tr": "y / ī", "ipa": "j, iː", "sun": false, "day": 7, "sound": "y as in 'yes', or a long 'ee' after a kasra", "example": { "ar": "يَوْم", "en": "day" } },
  { "id": "hamza", "char": "ء", "name": "hamza", "nameAr": "هَمْزَة", "tr": "ʾ", "ipa": "ʔ", "sun": false, "day": 7, "sound": "a glottal stop, the catch in 'uh-oh'; it often sits on an alif, waw or yaa seat (أ إ ؤ ئ)", "example": { "ar": "سَمَاء", "en": "sky" } },
  { "id": "ta-marbuta", "char": "ة", "name": "tāʾ marbūṭa", "nameAr": "تَاء مَرْبُوطَة", "tr": "a / at", "ipa": "a, at", "sun": false, "day": 7, "sound": "a 'tied t' that ends most feminine words: said 'a' in pause and 'at' when a vowel follows", "example": { "ar": "مَدْرَسَة", "en": "school" } },
  { "id": "alif-maqsura", "char": "ى", "name": "alif maqṣūra", "nameAr": "أَلِف مَقْصُورَة", "tr": "ā", "ipa": "aː", "sun": false, "day": 7, "sound": "a long 'aa' written like a yaa without dots, only at the end of a word", "example": { "ar": "إِلَى", "en": "to" } }
