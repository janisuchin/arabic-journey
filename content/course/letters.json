[
  { "id": "alif", "char": "ا", "name": "alif", "nameAr": "أَلِف", "tr": "ā / ʾ", "ipa": "aː, ʔ", "sun": false, "day": 1, "sound": "a long 'aa' after a consonant; at the start of a word it carries a hamza (a glottal stop)", "example": { "ar": "بَاب", "en": "door" } },
  { "id": "ba", "char": "ب", "name": "bāʾ", "nameAr": "بَاء", "tr": "b", "ipa": "b", "sun": false, "day": 1, "sound": "b as in 'book'", "example": { "ar": "بَيْت", "en": "house" } },
  { "id": "ta", "char": "ت", "name": "tāʾ", "nameAr": "تَاء", "tr": "t", "ipa": "t", "sun": true, "day": 1, "sound": "t as in 'ten', with the tongue touching the back of the top teeth", "example": { "ar": "تُفَّاح", "en": "apples" } },
  { "id": "tha", "char": "ث", "name": "thāʾ", "nameAr": "ثَاء", "tr": "th", "ipa": "θ", "sun": true, "day": 1, "sound": "th as in 'think' (never as in 'this')", "example": { "ar": "ثَلَاثَة", "en": "three" } },
  { "id": "jim", "char": "ج", "name": "jīm", "nameAr": "جِيم", "tr": "j", "ipa": "d͡ʒ", "sun": false, "day": 2, "sound": "j as in 'jam' (in Egypt it is said like g in 'go')", "example": { "ar": "جَمِيل", "en": "beautiful" } },
  { "id": "ha", "char": "ح", "name": "ḥāʾ", "nameAr": "حَاء", "tr": "ḥ", "ipa": "ħ", "sun": false, "day": 2, "sound": "a strong, breathy h made deep in the throat, like breathing on a cold window", "example": { "ar": "حَال", "en": "condition, state" } },
  { "id": "kha", "char": "خ", "name": "khāʾ", "nameAr": "خَاء", "tr": "kh", "ipa": "x", "sun": false, "day": 2, "sound": "ch as in Scottish 'loch' or German 'Bach'", "example": { "ar": "خَيْر", "en": "good" } },
  { "id": "dal", "char": "د", "name": "dāl", "nameAr": "دَال", "tr": "d", "ipa": "d", "sun": true, "day": 3, "sound": "d as in 'door', tongue on the back of the top teeth", "example": { "ar": "دَرْس", "en": "lesson" } },
  { "id": "dhal", "char": "ذ", "name": "dhāl", "nameAr": "ذَال", "tr": "dh", "ipa": "ð", "sun": true, "day": 3, "sound": "th as in 'this' (voiced)", "example": { "ar": "هٰذَا", "en": "this" } },
  { "id": "ra", "char": "ر", "name": "rāʾ", "nameAr": "رَاء", "tr": "r", "ipa": "r", "sun": true, "day": 3, "sound": "a tapped or rolled r, as in Spanish 'pero'", "example": { "ar": "رَقْم", "en": "number" } },
  { "id": "zay", "char": "ز", "name": "zāy", "nameAr": "زَاي", "tr": "z", "ipa": "z", "sun": true, "day": 3, "sound": "z as in 'zoo'", "example": { "ar": "زَوْج", "en": "husband" } },
  { "id": "sin", "char": "س", "name": "sīn", "nameAr": "سِين", "tr": "s", "ipa": "s", "sun": true, "day": 4, "sound": "s as in 'see'", "example": { "ar": "سَلَام", "en": "peace" } },
  { "id": "shin", "char": "ش", "name": "shīn", "nameAr": "شِين", "tr": "sh", "ipa": "ʃ", "sun": true, "day": 4, "sound": "sh as in 'she'", "example": { "ar": "شُكْرًا", "en": "thank you" } },
