  { "id": "dad", "char": "ض", "name": "ḍād", "nameAr": "ضَاد", "tr": "ḍ", "ipa": "dˤ", "sun": true, "day": 4, "sound": "an emphatic d: a heavy, dark d", "example": { "ar": "أَيْضًا", "en": "also" } },
